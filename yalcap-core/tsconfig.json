{
  "compilerOptions": {
    "target": "ES2021",
    "module": "es2020",
    "outDir": "target/classes/static/js",
    "rootDir": "src/main/resources/static/js",
    "noImplicitAny": true,
    "strict": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true,
    "lib": ["ES2021", "DOM"]
  },
  "files": [
    "src/main/resources/static/js/designer-types.d.ts"
  ],
  "include": [
    "src/main/resources/static/js/**/*.ts"
  ],
  "exclude": ["target", "node_modules", "**/*.test.ts", "**/*.spec.ts"],
  "watchOptions": {
    "watchFile": "fixedPollingInterval",
    "watchDirectory": "fixedPollingInterval",
    "fallbackPolling": "fixedInterval"
  }
}
