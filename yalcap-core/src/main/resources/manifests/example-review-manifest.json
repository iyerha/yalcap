{
  "id": "example-review",
  "title": "Example Review Workflow",
  "version": "1.0.0",
  "dataSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "applicantName": { "type": "string" },
      "amount": { "type": "number" },
      "notes": { "type": "string" }
    },
    "required": ["applicantName", "amount"]
  },
  "controlSchema": {
    "layout": [
      { "pointer": "#/properties/applicantName", "widget": "text" },
      { "pointer": "#/properties/amount", "widget": "number" },
      { "pointer": "#/properties/notes", "widget": "textarea" }
    ]
  },
  "steps": [
    {
      "id": "submit",
      "title": "Submit",
      "type": "form",
      "assignment": {
        "kind": "INTERNAL_GROUP",
        "value": "requestor",
        "mode": "first-wins",
        "multiInstance": false
      },
      "access": {
        "groups": ["requestor"],
        "users": []
      },
      "ui": {
        "pointer": "#/control/submit"
      },
      "routing": {
        "transitions": { "onSubmit": "review" }
      }
    },
    {
      "id": "review",
      "title": "Review",
      "type": "form",
      "assignment": {
        "kind": "INTERNAL_GROUP",
        "value": "finance",
        "mode": "parallel",
        "multiInstance": true
      },
      "access": {
        "groups": ["finance", "audit"],
        "users": ["alice", "bob"]
      },
      "ui": {
        "pointer": "#/control/review"
      },
      "routing": {
        "transitions": { "onApprove": "approved", "onReject": "submit" }
      }
    },
    {
      "id": "approved",
      "title": "Approved",
      "type": "form",
      "assignment": {
        "kind": "INTERNAL_GROUP",
        "value": "system",
        "mode": "first-wins",
        "multiInstance": false
      },
      "access": {
        "groups": ["system"],
        "users": []
      },
      "ui": {
        "pointer": "#/control/approved"
      },
      "routing": {
        "transitions": {}
      }
    }
  ]
}